# ─────────────────────────────────────────────────────────────
# Bursarly Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# For local dev, SQLite is used by default (no change needed below).
# For production with Supabase PostgreSQL:
DATABASE_URL=sqlite:///./bursarly.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Supabase Auth ─────────────────────────────────────────────
# Your project URL (same as frontend)
SUPABASE_URL=https://nvafmtkhshbfvmkkeohp.supabase.co

# Service role key — KEEP SECRET, never expose to client
# Found in: Project → Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret — used to verify user tokens on the backend
# Found in: Project → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
# ── Rate Limiting ─────────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute
LOGIN_RATE_LIMIT=5/minute

# ── Admin ─────────────────────────────────────────────────────
ADMIN_API_KEY=change-this-to-a-secure-random-string

# ── Search API (Optional for Chatbot RAG Fallback) ─────────────
TAVILY_API_KEY=your-tavily-api-key-here

